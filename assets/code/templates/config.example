# antcrate user config — sourced by wrapper and daemon.
# Copy to $XDG_CONFIG_HOME/antcrate/config (default ~/.config/antcrate/config)
# and uncomment what you need. All keys are optional.

# ANTCRATE_EMAIL="you@example.com"
# ANTCRATE_GIT_REMOTE_PREFIX="https://github.com/youruser/"
# ANTCRATE_LOG_LEVEL="info"

# (The ANTCRATE_*_PREAPPROVED prompt bypasses were retired 2026-07-10: every
# command is non-interactive by default — destructive ops back up first and
# file a review duty when no human is at the terminal.)

# Path-zone widening (default 0). Even when 1, backup + approval still apply.
# ANTCRATE_ALLOW_OUTSIDE_ROOT=0

# Local tool provisioning / install guard (see --tool-install, local-install-guard.sh)
# ANTCRATE_ALLOW_SYSTEM_INSTALL=0    # 1 = permit system-wide installs (audited)
# ANTCRATE_INSTALL_GUARD_DISABLE=0   # 1 = disable the local-install guard hook

# Backup retention (per project)
# ANTCRATE_BACKUP_RETENTION=20

# Backup targets — comma list, priority order (default: local).
# 'git-mirror' pushes each project's git-ignored dev/ tree as real git history
# to a PRIVATE companion repo <owner>/<project>-dev (created on first push).
# 'usb' is a future phase; unknown names are skipped with a warning, never a
# silent no-op.
# backup_targets=local,git-mirror

# dev/ auto-mirror after every successful `antcrate pp` push.
#
# DEFAULT-ON since 2026-07-24: every project mirrors its dev/ tree to a private
# <project>-dev companion, no config needed. This is what makes the default
# .gitignore's publication boundary safe — CLAUDE.md, AGENTS.md, .claude/ and
# dev/ are kept out of the public tree, and the mirror is where they go instead.
# `pp <p> --no-mirror` skips a single push.
#
# Opt a project out entirely:
# mirror_dev_exclude=someproject
#
# Turn the default off globally, falling back to the legacy opt-in allowlist:
# mirror_dev_all=0
#
# LEGACY allowlist. Still honoured, but it can only ADD now, never subtract —
# a config written under the old opt-in semantics cannot silently suppress a
# mirror you now expect by default. Safe to delete.
# mirror_dev=antcrate

# GitHub owner for the companion repos (default: the gh-authenticated login).
# mirror_owner=zeppybabe

# Extra intel feeds live in a SEPARATE file (not here):
#   ~/.config/antcrate/intel-sources.json  — {"sources":[{"id","url","kind"?}]}
# https-only, kind defaults to "dev"; hand-edit it yourself — agents read it,
# never write it. The pinned Anthropic seed list is unaffected.

*.log
.env*
node_modules/
__pycache__/

# Editor / OS noise
*.swp
*.swo
*~
.DS_Store

# Local-only secrets (mirrors lib/commit.sh ac_commit_secret_match)
*.pem
*.key
*.p12
*.pfx
credentials.json
.netrc

# NOTE: antcrate keeps the rest of the publication boundary in
# .git/info/exclude, never here. Naming those paths in a COMMITTED .gitignore
# would itself be a public trace of the local tooling the boundary exists to
# keep private. info/exclude protects identically and is never committed.
# Provisioned automatically on every push (lib/devsync.sh, ac_dev_ensure).
